# pixi: env is detached to ceph; keep only the lockfile under version control
.pixi/
# but do track the lockfile
!pixi.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# dask job logs / local scratch
dask-job-logs/
*.log

# editor
.vscode/
.idea/

# Site-specific dask configs and dataset files live here, untracked. The LEADING
# SLASH is load-bearing: a bare `configs/` matches at any depth. Generic dask
# templates ship in em-blockrun (em_blockrun/configs/).
/configs/

# Run manifests. `em-vol convert` defaults its progress path to the cwd, so
# running one from a repo checkout drops a multi-MB JSONL here (one record per
# block — 42 MB for a 772k-block run).
*.progress.jsonl
